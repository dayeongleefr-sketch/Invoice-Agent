{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "request_mode",
    "month",
    "target_aliases",
    "target_selection",
    "scope",
    "application",
    "summary",
    "reason",
    "criterion",
    "effective_from_month",
    "missing_fields",
    "reply",
    "catalog_query"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "conversation",
        "query_results",
        "inspect_evidence",
        "investigate_issue",
        "run_reconciliation",
        "set_disposition",
        "upsert_rule",
        "revoke_rule",
        "replay_version",
        "activate_revision",
        "register_materials",
        "register_evidence",
        "cancel_job",
        "unsupported_request",
        "clarify",
        "cancel_draft"
      ]
    },
    "request_mode": {
      "type": "string",
      "enum": [
        "request",
        "question",
        "negated"
      ]
    },
    "month": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 7
    },
    "target_aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 16
      },
      "maxItems": 8
    },
    "target_selection": {
      "type": "string",
      "enum": [
        "selected",
        "mentioned",
        "all_filtered",
        "unspecified"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "once",
        "future",
        "unspecified"
      ]
    },
    "application": {
      "type": "string",
      "enum": [
        "current_case",
        "future_only",
        "current_and_future",
        "unspecified"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "criterion": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "effective_from_month": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 7
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "target",
          "scope",
          "application",
          "month",
          "reason",
          "criterion",
          "effective_from_month",
          "operation"
        ]
      },
      "maxItems": 8
    },
    "reply": {
      "type": "string",
      "maxLength": 1800
    },
    "catalog_query": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "terms",
        "field",
        "match",
        "checks",
        "statuses",
        "scope",
        "same_reason_as_selected",
        "date_from",
        "date_to",
        "numeric_field",
        "numeric_operator",
        "numeric_value"
      ],
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          },
          "maxItems": 8
        },
        "field": {
          "type": "string",
          "enum": [
            "all",
            "reason",
            "method",
            "criterion"
          ]
        },
        "match": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 12
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "??",
              "???",
              "???",
              "?? ??"
            ]
          },
          "maxItems": 4
        },
        "scope": {
          "type": "string",
          "enum": [
            "all",
            "selected"
          ]
        },
        "same_reason_as_selected": {
          "type": "boolean"
        },
        "date_from": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "date_to": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "numeric_field": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "???",
            "???",
            "??",
            null
          ]
        },
        "numeric_operator": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            null
          ]
        },
        "numeric_value": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 30
        }
      }
    }
  }
}
